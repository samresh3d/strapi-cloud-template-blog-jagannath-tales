{
  "kind": "collectionType",
  "collectionName": "pages_festivals",
  "info": {
    "singularName": "pages-festival",
    "pluralName": "pages-festivals",
    "displayName": "Festival",
    "description": "Festival pages for Jagannath festivals and celebrations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageAlt": {
      "type": "string"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "story.paragraph",
        "story.heading",
        "story.image-block",
        "story.quote",
        "story.rich-text",
        "shared.quote-reference",
        "shared.festival-event-reference",
        "shared.festival-events-list"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "quotes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::data-quote.data-quote",
      "inversedBy": "pages_festivals"
    },
    "featuredQuote": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::data-quote.data-quote"
    },
    "festivalEvents": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::data-festival-event.data-festival-event",
      "inversedBy": "pages_festivals"
    },
    "featuredEvent": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::data-festival-event.data-festival-event"
    },
    "eventInstances": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::data-festival-event.data-festival-event"
    }
  }
}
