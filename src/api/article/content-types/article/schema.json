{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "A blog post or other piece of content."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "contentType": {
      "type": "enumeration",
      "enum": [
        "devotion",
        "miracle",
        "festival",
        "page"
      ]
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author"
    },
    "publishDate": {
      "type": "date"
    },
    "readingTime": {
      "type": "integer"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageAlt": {
      "type": "string"
    },
    "tags": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tag.tag",
      "inversedBy": "articles"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "articles"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "story.paragraph",
        "story.heading",
        "story.image-block",
        "story.quote",
        "story.rich-text",
        "shared.global-quote-reference",
        "shared.quote-reference",
        "shared.festival-event-reference",
        "shared.festival-events-list"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "quotes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::quote.quote",
      "inversedBy": "articles"
    },
    "featuredQuote": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::quote.quote"
    },
    "festivalEvents": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::festival-event.festival-event",
      "inversedBy": "articles"
    },
    "featuredEvent": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::festival-event.festival-event"
    }
  }
}
