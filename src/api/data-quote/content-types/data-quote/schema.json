{
  "kind": "singleType",
  "collectionName": "data_quotes",
  "info": {
    "singularName": "data-quote",
    "pluralName": "data-quotes",
    "displayName": "data-sanskrit-quotes",
    "description": "Reusable quotes in Sanskrit with English translations that can be referenced across content types"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "sanskrit_text"
    },
    "sanskrit_text": {
      "type": "text",
      "required": true
    },
    "english_translation": {
      "type": "text",
      "required": true
    },
    "author": {
      "type": "string",
      "required": false
    },
    "source": {
      "type": "string",
      "required": false
    },
    "pages_articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::pages-article.pages-article",
      "mappedBy": "quotes"
    }
  }
}
