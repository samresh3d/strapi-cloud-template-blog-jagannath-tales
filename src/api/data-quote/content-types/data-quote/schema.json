{
  "kind": "collectionType",
  "collectionName": "data_quotes",
  "info": {
    "singularName": "data-quote",
    "pluralName": "data-quotes",
    "displayName": "Data: Quote",
    "description": "Reusable quotes that can be referenced across content types"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "text": {
      "type": "text",
      "required": true
    },
    "author": {
      "type": "string",
      "required": false
    },
    "source": {
      "type": "string",
      "required": false
    },
    "category": {
      "type": "string",
      "required": false
    },
    "slug": {
      "type": "uid",
      "targetField": "text",
      "required": true
    },
    "pages_articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::pages-article.pages-article"
    },
    "pages_pages": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::pages-page.pages-page"
    }
  }
}
