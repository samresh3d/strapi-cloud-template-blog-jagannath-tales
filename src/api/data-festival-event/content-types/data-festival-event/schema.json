{
  "kind": "collectionType",
  "collectionName": "data_festival_events",
  "info": {
    "singularName": "data-festival-event",
    "pluralName": "data-festival-events",
    "displayName": "data-festival-event",
    "description": "Reusable upcoming festivals and celebrations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text",
      "required": false
    },
    "startDate": {
      "type": "date",
      "required": true
    },
    "endDate": {
      "type": "date",
      "required": false
    },
    "isAllDay": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "location": {
      "type": "string",
      "required": false
    },
    "importance": {
      "type": "enumeration",
      "required": true,
      "default": "major",
      "enum": [
        "major",
        "minor",
        "regional",
        "local"
      ]
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "rituals": {
      "type": "richtext",
      "required": false
    }
  }
}
