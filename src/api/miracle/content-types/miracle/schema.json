{
  "kind": "collectionType",
  "collectionName": "miracles",
  "info": {
    "singularName": "miracle",
    "pluralName": "miracles",
    "displayName": "Miracle",
    "description": "Divine miracles associated with Lord Jagannath"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "contents"
    },
    "publishedDate": {
      "type": "date"
    },
    "updatedDate": {
      "type": "date"
    },
    "readingTime": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageAlt": {
      "type": "string"
    },
    "tags": {
      "type": "json"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "shared.paragraph",
        "shared.heading",
        "shared.image",
        "shared.quote",
        "shared.rich-text",
        "shared.list"
      ]
    },
    "relatedStories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::miracle.miracle",
      "mappedBy": "relatedStories"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
