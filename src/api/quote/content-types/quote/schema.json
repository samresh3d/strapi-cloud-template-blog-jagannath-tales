{
  "kind": "collectionType",
  "collectionName": "quotes",
  "info": {
    "singularName": "quote",
    "pluralName": "quotes",
    "displayName": "Quote",
    "description": "Reusable quotes that can be referenced across content types"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "text": {
      "type": "text",
      "required": true
    },
    "author": {
      "type": "string",
      "required": false
    },
    "source": {
      "type": "string",
      "required": false
    },
    "category": {
      "type": "string",
      "required": false
    },
    "slug": {
      "type": "uid",
      "targetField": "text",
      "required": true
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "mappedBy": "quotes"
    },
    "pages": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::page.page",
      "mappedBy": "quotes"
    },
    "festivals": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::festival.festival",
      "mappedBy": "quotes"
    }
  }
}
