{
  "kind": "collectionType",
  "collectionName": "authors",
  "info": {
    "singularName": "author",
    "pluralName": "authors",
    "displayName": "Author",
    "description": "Authors who write content for the site"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "bio": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "social": {
      "type": "component",
      "repeatable": false,
      "component": "author.social"
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "author"
    },
    "devotions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::devotion.devotion",
      "mappedBy": "author"
    },
    "miracles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::miracle.miracle",
      "mappedBy": "author"
    },
    "festivals": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::festival.festival",
      "mappedBy": "author"
    }
  }
}
