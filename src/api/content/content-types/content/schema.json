{
  "kind": "collectionType",
  "collectionName": "contents",
  "info": {
    "singularName": "content",
    "pluralName": "contents",
    "displayName": "Content",
    "description": "All content types including devotions, festivals, miracles, and static pages"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "contentType": {
      "type": "enumeration",
      "enum": ["devotion", "festival", "miracle", "page"],
      "required": true,
      "default": "page"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "contents"
    },
    "publishDate": {
      "type": "date"
    },
    "updateDate": {
      "type": "date"
    },
    "readingTime": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "imageAlt": {
      "type": "string"
    },
    "tags": {
      "type": "json"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "shared.paragraph",
        "shared.heading",
        "shared.image",
        "shared.quote",
        "shared.rich-text",
        "shared.list"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "monthCelebrated": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "significance": {
      "type": "richtext"
    },
    "rituals": {
      "type": "component",
      "repeatable": true,
      "component": "festival.ritual"
    },
    "upcomingDates": {
      "type": "component",
      "repeatable": true,
      "component": "festival.upcoming-date"
    },
    "relatedContent": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::content.content",
      "mappedBy": "relatedContent"
    }
  }
}
