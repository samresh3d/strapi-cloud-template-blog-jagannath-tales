{
  "kind": "collectionType",
  "collectionName": "festivals",
  "info": {
    "singularName": "festival",
    "pluralName": "festivals",
    "displayName": "Festival",
    "description": "Festivals associated with Lord Jagannath"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "monthCelebrated": {
      "type": "string"
    },
    "duration": {
      "type": "string"
    },
    "significance": {
      "type": "richtext"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::author.author",
      "inversedBy": "festivals"
    },
    "publishedDate": {
      "type": "date"
    },
    "updatedDate": {
      "type": "date"
    },
    "readingTime": {
      "type": "string"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "featuredImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imageAlt": {
      "type": "string"
    },
    "tags": {
      "type": "json"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "shared.paragraph",
        "shared.heading",
        "shared.image",
        "shared.quote",
        "shared.rich-text",
        "shared.list"
      ]
    },
    "rituals": {
      "type": "component",
      "repeatable": true,
      "component": "festival.ritual"
    },
    "upcomingDates": {
      "type": "component",
      "repeatable": true,
      "component": "festival.upcoming-date"
    },
    "relatedStories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::festival.festival",
      "mappedBy": "relatedStories"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
