{
  "kind": "collectionType",
  "collectionName": "festival_events",
  "info": {
    "singularName": "festival-event",
    "pluralName": "festival-events",
    "displayName": "Festival Event",
    "description": "Reusable upcoming festivals and celebrations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text",
      "required": false
    },
    "startDate": {
      "type": "date",
      "required": true
    },
    "endDate": {
      "type": "date",
      "required": false
    },
    "isAllDay": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "location": {
      "type": "string",
      "required": false
    },
    "importance": {
      "type": "enumeration",
      "enum": [
        "major",
        "minor",
        "regional",
        "local"
      ],
      "default": "major",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "rituals": {
      "type": "richtext",
      "required": false
    },
    "relatedFestival": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::festival.festival",
      "inversedBy": "eventInstances"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article",
      "mappedBy": "festivalEvents"
    },
    "pages": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::page.page",
      "mappedBy": "festivalEvents"
    }
  }
}
