{
  "kind": "collectionType",
  "collectionName": "pages_pages",
  "info": {
    "singularName": "pages-page",
    "pluralName": "pages-pages",
    "displayName": "Page",
    "description": "Static pages like About, Contact, etc."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "story.paragraph",
        "story.heading",
        "story.image-block",
        "story.quote",
        "story.rich-text",
        "shared.quote-reference",
        "shared.festival-event-reference",
        "shared.festival-events-list"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    },
    "quotes": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::data-quote.data-quote"
    },
    "featuredQuote": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::data-quote.data-quote"
    },
    "festivalEvents": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::data-festival-event.data-festival-event"
    },
    "featuredEvent": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::data-festival-event.data-festival-event"
    }
  }
}
