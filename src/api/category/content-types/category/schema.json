{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },

    "pages_articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::pages-article.pages-article",
      "mappedBy": "categories"
    }
  }
}
