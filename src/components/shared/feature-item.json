{
  "collectionName": "components_shared_feature_items",
  "info": {
    "displayName": "Feature Item",
    "description": "Icon + title + rich description + optional link"
  },
  "options": {},
  "attributes": {
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "link": {
      "type": "component",
      "repeatable": false,
      "component": "site.navigation-link"
    }
  }
}

