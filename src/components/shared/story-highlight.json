{
  "collectionName": "components_shared_story_highlights",
  "info": {
    "displayName": "Story Highlight",
    "description": "Image + heading + rich text callout"
  },
  "options": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "imageAlt": { "type": "string" },
    "title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "layout": {
      "type": "enumeration",
      "enum": ["image-left", "image-right"],
      "default": "image-left"
    },
    "theme": {
      "type": "enumeration",
      "enum": ["light", "brand", "neutral"],
      "default": "light"
    }
  }
}

